# Todo esto es OPCIONAL. La herramienta funciona sin ningún archivo .env: cada persona
# puede pegar sus claves en el panel ⚙️ Configuración, y se quedan en su navegador.
#
# ⚠️ Toda variable que empiece por VITE_ se incrusta en el JavaScript que sirve la
# herramienta. Úsalas solo en TU equipo y NUNCA copies tu .env a otra persona ni a un
# paquete que vayas a repartir.

# Clave de Gemini (respaldo de lectura: si la pegas en ⚙️ Configuración, esa manda).
# Obtén una en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OPCIONAL Y AVANZADO. La herramienta ya no pide la clave de ElevenLabs: generar el sonido es un
# paso manual, en su página. Solo si pones una clave aquí, la herramienta ofrece además generar
# bocetos dentro de ella. Sin clave no aparece ningún botón de generar.
# Obtén una en: https://elevenlabs.io
VITE_ELEVENLABS_API_KEY=

# Vista con la que se abre la herramienta la primera vez: "simple" o "full".
# Para el paquete de los compañeros se pone "simple". Lo que cada persona elija después
# con el interruptor de la barra superior se recuerda y manda sobre esto.
VITE_DEFAULT_VIEW=

# Claude (Anthropic) y OpenAI NO tienen variable de entorno, a propósito: sus claves solo
# se pegan en ⚙️ Configuración, para que nunca queden incrustadas en el código servido.
